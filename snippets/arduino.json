  "Arduino blink": {
    "prefix": "blink",
    "body": [
      "void setup() {",
      "  pinMode(${1:yourLED_BUILTIN}, OUTPUT);",
      "}",
      "",
      "void loop() {",
      "  digitalWrite(${1:yourLED_BUILTIN}, HIGH);",
      "  delay(${2:500});",
      "  digitalWrite(${1:yourLED_BUILTIN}, LOW);",
      "  delay(${2:500});",
      "}"
    ],
    "description": "Arduino blink"
  },
  "Arduino millis non-blocking": {
    "prefix": "millis",
    "body": [
      "unsigned long ${1:yourPrevMillis} = 0;",
      "const unsigned long ${2:yourInterval} = ${3:1000};",
      "",
      "void loop() {",
      "  unsigned long currentMillis = millis();",
      "  if (currentMillis - ${1:yourPrevMillis} >= ${2:yourInterval}) {",
      "    ${1:yourPrevMillis} = currentMillis;",
      "    ${4}",
      "  }",
      "}"
    ],
    "description": "Arduino non-blocking millis"
  },
  "Arduino debounce": {
    "prefix": "debounce",
    "body": [
      "const int ${1:yourBUTTON_PIN} = ${2:2};",
      "int lastState = HIGH;",
      "unsigned long lastDebounceTime = 0;",
      "const unsigned long debounceDelay = ${3:50};",
      "",
      "void loop() {",
      "  int reading = digitalRead(${1:yourBUTTON_PIN});",
      "  if (reading != lastState) {",
      "    lastDebounceTime = millis();",
      "  }",
      "  if ((millis() - lastDebounceTime) > debounceDelay) {",
      "    ${4}",
      "  }",
      "  lastState = reading;",
      "}"
    ],
    "description": "Arduino button debounce"
  },
