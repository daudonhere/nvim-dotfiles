      "PubSubClient client(espClient);",
      "",
      "void callback(char* topic, byte* payload, unsigned int length) {",
      "  ${1}",
      "}",
      "",
      "void reconnect() {",
      "  while (!client.connected()) {",
      "    if (client.connect(\"${2:yourClientId}\", \"${3:yourUser}\", \"${4:yourPass}\")) {",
      "      client.subscribe(\"${5:yourTopic}\");",
      "    } else {",
      "      delay(5000);",
      "    }",
      "  }",
      "}"
    ],
    "description": "Arduino MQTT PubSubClient"
