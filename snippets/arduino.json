    "prefix": "rgb",
    "body": [
      "const int rPin = ${1:9}, gPin = ${2:10}, bPin = ${3:11};",
      "",
      "void setColor(int r, int g, int b) {",
      "  analogWrite(rPin, r);",
      "  analogWrite(gPin, g);",
