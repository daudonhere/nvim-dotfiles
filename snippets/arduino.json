  "Arduino NTP time": {
    "prefix": "ntp",
    "body": [
      "#include <WiFi.h>",
      "#include <time.h>",
      "",
      "const char* ntpServer = \"${1:pool.ntp.org}\";",
      "const long gmtOffset_sec = ${2:3600 * 7};",
      "const int daylightOffset_sec = ${3:0};",
      "",
      "void setup() {",
      "  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);",
      "  struct tm timeinfo;",
      "  if (getLocalTime(&timeinfo)) {",
      "    Serial.println(&timeinfo, '%B %d %Y %H:%M:%S');",
      "  } else {",
      "    Serial.println(\"NTP failed\");",
      "  }",
      "}"
    ],
    "description": "Arduino NTP time"
  },
