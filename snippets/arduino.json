  },
  "Arduino melody": {
    "prefix": "melody",
    "body": [
      "const int buzzerPin = ${1:8};",
      "int melody[] = {${2:262, 330, 392, 523}};",
      "int durations[] = {${3:4, 4, 4, 4}};",
      "",
      "void playMelody() {",
      "  for (int i = 0; i < ${4:4}; i++) {",
      "    int dur = 1000 / durations[i];",
      "    tone(buzzerPin, melody[i], dur);",
      "    delay(dur * 1.3);",
      "  }",
      "}"
    ],
    "description": "Arduino melody with tone"
  },
  "Arduino rotary encoder": {
    "prefix": "rotary",
    "body": [
      "const int clkPin = ${1:2}, dtPin = ${2:3};",
      "int lastClk = digitalRead(clkPin);",
      "int position = 0;",
      "",
      "void loop() {",
      "  int clk = digitalRead(clkPin);",
      "  if (clk != lastClk) {",
      "    position += (digitalRead(dtPin) != clk) ? 1 : -1;",
      "  }",
      "  lastClk = clk;",
      "}"
    ],
    "description": "Arduino rotary encoder"
  },
