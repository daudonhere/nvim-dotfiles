  "Arduino PWM fade": {
    "prefix": "fade",
    "body": [
      "int ${1:yourBrightness} = 0;",
      "int fadeAmount = 5;",
      "",
      "void loop() {",
      "  analogWrite(${2:9}, ${1:yourBrightness});",
      "  ${1:yourBrightness} += fadeAmount;",
      "  if (${1:yourBrightness} <= 0 || ${1:yourBrightness} >= 255) fadeAmount = -fadeAmount;",
      "  delay(30);",
      "}"
    ],
    "description": "Arduino PWM fade"
  },
