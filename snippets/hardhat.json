{
  "Hardhat config": {
    "prefix": "hhc",
    "body": [
      "import { HardhatUserConfig } from 'hardhat/config';",
      "import '@nomicfoundation/hardhat-toolbox';",
      "",
      "const config: HardhatUserConfig = {",
      "  solidity: '${1:0.8.24}',",
      "  networks: {",
      "    ${2:yourSepolia}: {",
      "      url: process.env.${3:yourRPC_URL} as string,",
      "      accounts: [process.env.${4:yourPRIVATE_KEY} as string],",
      "    },",
      "  },",
      "  etherscan: {",
      "    apiKey: process.env.${5:yourETHERSCAN_API_KEY},",
      "  },",
      "};",
      "",
      "export default config;"
    ],
    "description": "Hardhat config.ts skeleton"
  },
  "Hardhat deploy script": {
    "prefix": "hhd",
    "body": [
      "import { ethers } from 'hardhat';",
      "",
      "async function main() {",
      "  const ${1:yourToken} = await ethers.getContractFactory('${1:yourToken}');",
      "  const token = await ${1:yourToken}.deploy(${2});",
      "  await token.waitForDeployment();",
      "  console.log('${1:yourToken} deployed to:', await token.getAddress());",
      "}",
      "",
      "main().catch((error) => {",
      "  console.error(error);",
      "  process.exitCode = 1;",
      "});"
    ],
    "description": "Hardhat deploy script"
  },
  "Hardhat main": {
    "prefix": "hhmain",
    "body": [
      "async function main() {",
      "  ${1}",
      "}",
      "",
      "main().catch((error) => {",
      "  console.error(error);",
      "  process.exitCode = 1;",
      "});"
    ],
    "description": "Hardhat async main boilerplate"
  },
  "Hardhat test skeleton": {
    "prefix": "hhtest",
    "body": [
      "const { expect } = require('chai');",
      "const { ethers } = require('hardhat');",
      "",
      "describe('${1:yourThing}', function () {",
      "  let ${2:yourThing};",
      "  let ${3:yourOwner};",
      "",
      "  beforeEach(async function () {",
      "    [${3:yourOwner}] = await ethers.getSigners();",
      "    const ${4:yourFactory} = await ethers.getContractFactory('${1:yourThing}');",
      "    ${2:yourThing} = await ${4:yourFactory}.deploy();",
      "    await ${2:yourThing}.waitForDeployment();",
      "  });",
      "",
      "  it('${5:should work}', async function () {",
      "    ${6}",
      "  });",
      "});"
    ],
    "description": "Hardhat mocha test skeleton"
  },
  "Hardhat task": {
    "prefix": "hht",
    "body": [
      "import { task } from 'hardhat/config';",
      "",
      "task('${1:yourName}', '${2:yourDescription}')",
      "  .addParam('${3:yourParam}', '${4}')",
      "  .setAction(async ({ ${3:yourParam} }, hre) => {",
      "    ${5}",
      "  });"
    ],
    "description": "Hardhat custom task"
  },
  "Hardhat verify": {
    "prefix": "hhv",
    "body": [
      "await hre.run('verify:verify', {",
      "  address: '${1:0x...}',",
      "  constructorArguments: [${2}],",
      "});"
    ],
    "description": "Hardhat verify contract"
  },
  "Hardhat getContractFactory": {
    "prefix": "hhcf",
    "body": [
      "const ${1:yourToken} = await ethers.getContractFactory('${1:yourToken}');"
    ],
    "description": "Hardhat getContractFactory"
  },
  "Hardhat getContractAt": {
    "prefix": "hhget",
    "body": [
      "const ${1:yourToken} = await ethers.getContractAt('${2:yourToken}', '${3:0x...}');"
    ],
    "description": "Hardhat getContractAt"
  },
  "Hardhat signers": {
    "prefix": "hhsigner",
    "body": [
      "const [${1:yourDeployer}, ${2:yourUser}] = await ethers.getSigners();"
    ],
    "description": "Hardhat getSigners"
  },
  "Hardhat balance": {
    "prefix": "hhbal",
    "body": [
      "const balance = await ethers.provider.getBalance('${1:0x...}');",
      "console.log('Balance:', ethers.formatEther(balance));"
    ],
    "description": "Hardhat getBalance + formatEther"
  },
  "Hardhat parseEther": {
    "prefix": "hhparse",
    "body": [
      "ethers.parseEther('${1:1}')"
    ],
    "description": "Hardhat ethers.parseEther"
  },
  "Hardhat units": {
    "prefix": "hhunits",
    "body": [
      "ethers.parseUnits('${1:1}', ${2:18})"
    ],
    "description": "Hardhat ethers.parseUnits"
  },
  "Hardhat formatUnits": {
    "prefix": "hhfmt",
    "body": [
      "ethers.formatUnits(${1:yourValue}, ${2:18})"
    ],
    "description": "Hardhat ethers.formatUnits"
  },
  "Hardhat console.log": {
    "prefix": "hhcon",
    "body": [
      "console.log('${1:yourLabel}:', ${2:yourValue});"
    ],
    "description": "Hardhat console.log"
  },
  "Hardhat upgrade proxy": {
    "prefix": "hhup",
    "body": [
      "import { upgrades } from 'hardhat';",
      "",
      "const ${1:yourV1} = await ethers.getContractFactory('${1:yourV1}');",
      "const proxy = await upgrades.deployProxy(${1:yourV1}, [${2}], { initializer: 'initialize' });",
      "await proxy.waitForDeployment();"
    ],
    "description": "Hardhat OpenZeppelin upgrades deployProxy"
  },
  "Hardhat expect revert": {
    "prefix": "hhexpect",
    "body": [
      "await expect(${1:yourTx}).to.be.revertedWith('${2:yourReason}');"
    ],
    "description": "Hardhat chai expect revert"
  },
  "Hardhat expect emit": {
    "prefix": "hhemit",
    "body": [
      "await expect(${1:yourTx})",
      "  .to.emit(${2:yourContract}, '${3:yourEvent}')",
      "  .withArgs(${4});"
    ],
    "description": "Hardhat chai expect emit"
  },
  "Hardhat expect increase": {
    "prefix": "hhinc",
    "body": [
      "await expect(${1:yourTx})",
      "  .to.changeTokenBalance(${2:yourToken}, ${3:yourAddr}, ${4:ethers.parseEther('1')});"
    ],
    "description": "Hardhat chai changeTokenBalance"
  },
  "Hardhat time increase": {
    "prefix": "hhtime",
    "body": [
      "await ethers.provider.send('evm_increaseTime', [${1:86400}]);",
      "await ethers.provider.send('evm_mine', []);"
    ],
    "description": "Hardhat evm_increaseTime"
  },
  "Hardhat gas estimate": {
    "prefix": "hhgas",
    "body": [
      "const gas = await ${1:yourContract}.${2:yourMethod}.estimateGas(${3});",
      "console.log('Gas:', gas.toString());"
    ],
    "description": "Hardhat estimateGas"
  },
  "Hardhat balanceOf": {
    "prefix": "hhbalof",
    "body": [
      "const balance = await ${1:yourToken}.balanceOf(${2:yourAddr});",
      "console.log('Balance:', ethers.formatUnits(balance, 18));"
    ],
    "description": "Hardhat ERC20 balanceOf"
  },
  "Hardhat provider block": {
    "prefix": "hhblock",
    "body": [
      "const block = await ethers.provider.getBlock('${1:yourLatest}');",
      "console.log(block);"
    ],
    "description": "Hardhat getBlock"
  },
  "Hardhat getAddress": {
    "prefix": "hhaddr",
    "body": [
      "await ${1:yourContract}.getAddress()"
    ],
    "description": "Hardhat contract getAddress"
  },
  "Hardhat chainId": {
    "prefix": "hhchainid",
    "body": [
      "const chainId = (await ethers.provider.getNetwork()).chainId;",
      "console.log('Chain ID:', chainId);"
    ],
    "description": "Hardhat chainId"
  },
  "Hardhat provider send": {
    "prefix": "hhprovider",
    "body": [
      "const provider = hre.network.provider;",
      "const blockNumber = await provider.send('eth_blockNumber', []);",
      "console.log('Block number:', blockNumber);"
    ],
    "description": "Hardhat network provider"
  },
  "Hardhat approve": {
    "prefix": "hhapprove",
    "body": [
      "await ${1:yourToken}.connect(${2:yourOwner}).approve(${3:yourSpender}, ${4:ethers.parseEther('100')});"
    ],
    "description": "Hardhat ERC20 approve"
  },
  "Hardhat transfer": {
    "prefix": "hhtransfer",
    "body": [
      "await ${1:yourToken}.connect(${2:yourOwner}).transfer(${3:yourTo}, ${4:ethers.parseEther('1')});"
    ],
    "description": "Hardhat ERC20 transfer"
  },
  "Hardhat allowance": {
    "prefix": "hhallowance",
    "body": [
      "const allowance = await ${1:yourToken}.allowance(${2:yourOwner}, ${3:yourSpender});"
    ],
    "description": "Hardhat ERC20 allowance"
  },
  "Hardhat connect signer": {
    "prefix": "hhconnect",
    "body": [
      "const ${1:yourSigned} = ${2:yourContract}.connect(${3:yourSigner});"
    ],
    "description": "Hardhat contract.connect"
  },
  "Hardhat attach": {
    "prefix": "hhattach",
    "body": [
      "const ${1:yourToken} = await ${2:yourFactory}.attach('${3:0x...}');"
    ],
    "description": "Hardhat contract.attach"
  },
  "Hardhat loadFixture": {
    "prefix": "hhfixture",
    "body": [
      "const { loadFixture } = require('@nomicfoundation/hardhat-toolbox/network-helpers');",
      "",
      "async function deployFixture() {",
      "  const [owner] = await ethers.getSigners();",
      "  const ${1:yourFactory} = await ethers.getContractFactory('${2:yourThing}');",
      "  const ${3:yourThing} = await ${1:yourFactory}.deploy();",
      "  return { owner, ${3:yourThing} };",
      "}",
      "",
      "const { owner, ${3:yourThing} } = await loadFixture(deployFixture);"
    ],
    "description": "Hardhat loadFixture pattern"
  },
  "Hardhat test timeout": {
    "prefix": "hhtimeout",
    "body": [
      "this.timeout(${1:200000});"
    ],
    "description": "Hardhat mocha timeout"
  },
  "Hardhat chai assert": {
    "prefix": "hhassert",
    "body": [
      "const { assert } = require('chai');",
      "assert.equal(${1:yourActual}, ${2:yourExpected});"
    ],
    "description": "Hardhat chai assert.equal"
  },
  "Hardhat BigInt amount": {
    "prefix": "hhbn",
    "body": [
      "const AMOUNT = ${1:1000n};"
    ],
    "description": "Hardhat BigInt literal"
  },
  "Hardhat token name/symbol": {
    "prefix": "hhname",
    "body": [
      "const name = await ${1:yourToken}.name();",
      "const symbol = await ${1:yourToken}.symbol();",
      "console.log(name, symbol);"
    ],
    "description": "Hardhat ERC20 name/symbol"
  },
  "Hardhat tx wait": {
    "prefix": "hhtxwait",
    "body": [
      "const tx = await ${1:yourContract}.${2:yourMethod}(${3});",
      "await tx.wait();",
      "console.log('Tx hash:', tx.hash);"
    ],
    "description": "Hardhat send tx + wait"
  },
  "Hardhat env check": {
    "prefix": "hhenv",
    "body": [
      "const ${1:yourPRIVATE_KEY} = process.env.${1:yourPRIVATE_KEY};",
      "if (!${1:yourPRIVATE_KEY}) throw new Error('missing env ${1:yourPRIVATE_KEY}');"
    ],
    "description": "Hardhat env variable check"
  },
  "Hardhat new Wallet": {
    "prefix": "hhwallet",
    "body": [
      "const { Wallet } = ethers;",
      "const wallet = new Wallet(process.env.${1:yourPRIVATE_KEY});"
    ],
    "description": "Hardhat new Wallet"
  },
  "Hardhat all signers": {
    "prefix": "hhaccounts",
    "body": [
      "const accounts = await ethers.getSigners();",
      "const [owner, addr1, addr2] = accounts;"
    ],
    "description": "Hardhat getSigners destructure"
  },
  "Hardhat deploy helper": {
    "prefix": "hhdeployhelper",
    "body": [
      "async function deployContract(name, args = []) {",
      "  const ${1:yourFactory} = await ethers.getContractFactory(name);",
      "  const contract = await ${1:yourFactory}.deploy(...args);",
      "  await contract.waitForDeployment();",
      "  return contract;",
      "}"
    ],
    "description": "Hardhat reusable deploy helper"
  }
}