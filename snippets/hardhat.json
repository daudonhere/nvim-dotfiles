{
  "Hardhat config": {
    "prefix": "hhc",
    "body": [
      "import { HardhatUserConfig } from 'hardhat/config';",
      "import '@nomicfoundation/hardhat-toolbox';",
      "",
      "const config: HardhatUserConfig = {",
      "  solidity: '${1:0.8.24}',",
      "  networks: {",
      "    ${2:sepolia}: {",
      "      url: process.env.${3:RPC_URL} as string,",
      "      accounts: [process.env.${4:PRIVATE_KEY} as string],",
      "    },",
      "  },",
      "  etherscan: {",
      "    apiKey: process.env.${5:ETHERSCAN_API_KEY},",
      "  },",
      "};",
      "",
      "export default config;"
    ],
    "description": "Hardhat config.ts skeleton"
  },
  "Hardhat deploy script": {
    "prefix": "hhd",
    "body": [
      "import { ethers } from 'hardhat';",
      "",
      "async function main() {",
      "  const ${1:Token} = await ethers.getContractFactory('${1:Token}');",
      "  const token = await ${1:Token}.deploy(${2});",
      "  await token.waitForDeployment();",
      "  console.log('${1:Token} deployed to:', await token.getAddress());",
      "}",
      "",
      "main().catch((error) => {",
      "  console.error(error);",
      "  process.exitCode = 1;",
      "});"
    ],
    "description": "Hardhat deploy script"
  },
  "Hardhat main": {
    "prefix": "hhmain",
    "body": [
      "async function main() {",
      "  ${1}",
      "}",
      "",
      "main().catch((error) => {",
      "  console.error(error);",
      "  process.exitCode = 1;",
      "});"
    ],
    "description": "Hardhat async main boilerplate"
  },
  "Hardhat test skeleton": {
    "prefix": "hhtest",
    "body": [
      "const { expect } = require('chai');",
      "const { ethers } = require('hardhat');",
      "",
      "describe('${1:Thing}', function () {",
      "  let ${2:thing};",
      "  let ${3:owner};",
      "",
      "  beforeEach(async function () {",
      "    [${3:owner}] = await ethers.getSigners();",
      "    const ${4:Factory} = await ethers.getContractFactory('${1:Thing}');",
      "    ${2:thing} = await ${4:Factory}.deploy();",
      "    await ${2:thing}.waitForDeployment();",
      "  });",
      "",
      "  it('${5:should work}', async function () {",
      "    ${6}",
      "  });",
      "});"
    ],
    "description": "Hardhat mocha test skeleton"
  },
  "Hardhat task": {
    "prefix": "hht",
    "body": [
      "import { task } from 'hardhat/config';",
      "",
      "task('${1:name}', '${2:description}')",
      "  .addParam('${3:param}', '${4}')",
      "  .setAction(async ({ ${3:param} }, hre) => {",
      "    ${5}",
      "  });"
    ],
    "description": "Hardhat custom task"
  },
  "Hardhat verify": {
    "prefix": "hhv",
    "body": [
      "await hre.run('verify:verify', {",
      "  address: '${1:0x...}',",
      "  constructorArguments: [${2}],",
      "});"
    ],
    "description": "Hardhat verify contract"
  },
  "Hardhat getContractFactory": {
    "prefix": "hhcf",
    "body": [
      "const ${1:Token} = await ethers.getContractFactory('${1:Token}');"
    ],
    "description": "Hardhat getContractFactory"
  },
  "Hardhat getContractAt": {
    "prefix": "hhget",
    "body": [
      "const ${1:token} = await ethers.getContractAt('${2:Token}', '${3:0x...}');"
    ],
    "description": "Hardhat getContractAt"
  },
  "Hardhat signers": {
    "prefix": "hhsigner",
    "body": [
      "const [${1:deployer}, ${2:user}] = await ethers.getSigners();"
    ],
    "description": "Hardhat getSigners"
  },
  "Hardhat balance": {
    "prefix": "hhbal",
    "body": [
      "const balance = await ethers.provider.getBalance('${1:0x...}');",
      "console.log('Balance:', ethers.formatEther(balance));"
    ],
    "description": "Hardhat getBalance + formatEther"
  },
  "Hardhat parseEther": {
    "prefix": "hhparse",
    "body": [
      "ethers.parseEther('${1:1}')"
    ],
    "description": "Hardhat ethers.parseEther"
  },
  "Hardhat units": {
    "prefix": "hhunits",
    "body": [
      "ethers.parseUnits('${1:1}', ${2:18})"
    ],
    "description": "Hardhat ethers.parseUnits"
  },
  "Hardhat formatUnits": {
    "prefix": "hhfmt",
    "body": [
      "ethers.formatUnits(${1:value}, ${2:18})"
    ],
    "description": "Hardhat ethers.formatUnits"
  },
  "Hardhat console.log": {
    "prefix": "hhcon",
    "body": [
      "console.log('${1:label}:', ${2:value});"
    ],
    "description": "Hardhat console.log"
  },
  "Hardhat upgrade proxy": {
    "prefix": "hhup",
    "body": [
      "import { upgrades } from 'hardhat';",
      "",
      "const ${1:V1} = await ethers.getContractFactory('${1:V1}');",
      "const proxy = await upgrades.deployProxy(${1:V1}, [${2}], { initializer: 'initialize' });",
      "await proxy.waitForDeployment();"
    ],
    "description": "Hardhat OpenZeppelin upgrades deployProxy"
  },
  "Hardhat expect revert": {
    "prefix": "hhexpect",
    "body": [
      "await expect(${1:tx}).to.be.revertedWith('${2:reason}');"
    ],
    "description": "Hardhat chai expect revert"
  },
  "Hardhat expect emit": {
    "prefix": "hhemit",
    "body": [
      "await expect(${1:tx})",
      "  .to.emit(${2:contract}, '${3:Event}')",
      "  .withArgs(${4});"
    ],
    "description": "Hardhat chai expect emit"
  },
  "Hardhat expect increase": {
    "prefix": "hhinc",
    "body": [
      "await expect(${1:tx})",
      "  .to.changeTokenBalance(${2:token}, ${3:addr}, ${4:ethers.parseEther('1')});"
    ],
    "description": "Hardhat chai changeTokenBalance"
  },
  "Hardhat time increase": {
    "prefix": "hhtime",
    "body": [
      "await ethers.provider.send('evm_increaseTime', [${1:86400}]);",
      "await ethers.provider.send('evm_mine', []);"
    ],
    "description": "Hardhat evm_increaseTime"
  },
  "Hardhat gas estimate": {
    "prefix": "hhgas",
    "body": [
      "const gas = await ${1:contract}.${2:method}.estimateGas(${3});"
    ],
    "description": "Hardhat estimateGas"
  },
  "Hardhat balanceOf": {
    "prefix": "hhbalof",
    "body": [
      "const balance = await ${1:token}.balanceOf(${2:addr});"
    ],
    "description": "Hardhat ERC20 balanceOf"
  },
  "Hardhat provider block": {
    "prefix": "hhblock",
    "body": [
      "const block = await ethers.provider.getBlock('${1:latest}');"
    ],
    "description": "Hardhat getBlock"
  },
  "Hardhat getAddress": {
    "prefix": "hhaddr",
    "body": [
      "await ${1:contract}.getAddress()"
    ],
    "description": "Hardhat contract getAddress"
  },
  "Hardhat chainId": {
    "prefix": "hhchainid",
    "body": [
      "const chainId = (await ethers.provider.getNetwork()).chainId;"
    ],
    "description": "Hardhat chainId"
  },
  "Hardhat provider send": {
    "prefix": "hhprovider",
    "body": [
      "const provider = hre.network.provider;",
      "const blockNumber = await provider.send('eth_blockNumber', []);"
    ],
    "description": "Hardhat network provider"
  },
  "Hardhat approve": {
    "prefix": "hhapprove",
    "body": [
      "await ${1:token}.connect(${2:owner}).approve(${3:spender}, ${4:ethers.parseEther('100')});"
    ],
    "description": "Hardhat ERC20 approve"
  },
  "Hardhat transfer": {
    "prefix": "hhtransfer",
    "body": [
      "await ${1:token}.connect(${2:owner}).transfer(${3:to}, ${4:ethers.parseEther('1')});"
    ],
    "description": "Hardhat ERC20 transfer"
  },
  "Hardhat allowance": {
    "prefix": "hhallowance",
    "body": [
      "const allowance = await ${1:token}.allowance(${2:owner}, ${3:spender});"
    ],
    "description": "Hardhat ERC20 allowance"
  },
  "Hardhat connect signer": {
    "prefix": "hhconnect",
    "body": [
      "const ${1:signed} = ${2:contract}.connect(${3:signer});"
    ],
    "description": "Hardhat contract.connect"
  },
  "Hardhat attach": {
    "prefix": "hhattach",
    "body": [
      "const ${1:token} = await ${2:factory}.attach('${3:0x...}');"
    ],
    "description": "Hardhat contract.attach"
  },
  "Hardhat loadFixture": {
    "prefix": "hhfixture",
    "body": [
      "const { loadFixture } = require('@nomicfoundation/hardhat-toolbox/network-helpers');",
      "",
      "async function deployFixture() {",
      "  const [owner] = await ethers.getSigners();",
      "  const ${1:Factory} = await ethers.getContractFactory('${2:Thing}');",
      "  const ${3:thing} = await ${1:Factory}.deploy();",
      "  return { owner, ${3:thing} };",
      "}",
      "",
      "const { owner, ${3:thing} } = await loadFixture(deployFixture);"
    ],
    "description": "Hardhat loadFixture pattern"
  },
  "Hardhat test timeout": {
    "prefix": "hhtimeout",
    "body": [
      "this.timeout(${1:200000});"
    ],
    "description": "Hardhat mocha timeout"
  },
  "Hardhat chai assert": {
    "prefix": "hhassert",
    "body": [
      "const { assert } = require('chai');",
      "assert.equal(${1:actual}, ${2:expected});"
    ],
    "description": "Hardhat chai assert.equal"
  },
  "Hardhat BigInt amount": {
    "prefix": "hhbn",
    "body": [
      "const AMOUNT = ${1:1000n};"
    ],
    "description": "Hardhat BigInt literal"
  },
  "Hardhat token name/symbol": {
    "prefix": "hhname",
    "body": [
      "const name = await ${1:token}.name();",
      "const symbol = await ${1:token}.symbol();"
    ],
    "description": "Hardhat ERC20 name/symbol"
  },
  "Hardhat tx wait": {
    "prefix": "hhtxwait",
    "body": [
      "const tx = await ${1:contract}.${2:method}(${3});",
      "await tx.wait();"
    ],
    "description": "Hardhat send tx + wait"
  },
  "Hardhat env check": {
    "prefix": "hhenv",
    "body": [
      "const ${1:PRIVATE_KEY} = process.env.${1:PRIVATE_KEY};",
      "if (!${1:PRIVATE_KEY}) throw new Error('missing env ${1:PRIVATE_KEY}');"
    ],
    "description": "Hardhat env variable check"
  },
  "Hardhat new Wallet": {
    "prefix": "hhwallet",
    "body": [
      "const { Wallet } = ethers;",
      "const wallet = new Wallet(process.env.${1:PRIVATE_KEY});"
    ],
    "description": "Hardhat new Wallet"
  },
  "Hardhat all signers": {
    "prefix": "hhaccounts",
    "body": [
      "const accounts = await ethers.getSigners();",
      "const [owner, addr1, addr2] = accounts;"
    ],
    "description": "Hardhat getSigners destructure"
  },
  "Hardhat deploy helper": {
    "prefix": "hhdeployhelper",
    "body": [
      "async function deployContract(name, args = []) {",
      "  const ${1:Factory} = await ethers.getContractFactory(name);",
      "  const contract = await ${1:Factory}.deploy(...args);",
      "  await contract.waitForDeployment();",
      "  return contract;",
      "}"
    ],
    "description": "Hardhat reusable deploy helper"
  }
}
