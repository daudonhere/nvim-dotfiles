{
  "Express app": {
    "prefix": "exs",
    "body": [
      "const express = require('express');",
      "const app = express();",
      "app.use(express.json());",
      "",
      "app.get('/', (req, res) => {",
      "  res.send('${1:Hello World}');",
      "});",
      "",
      "const PORT = process.env.PORT || ${2:3000};",
      "app.listen(PORT, () => console.log('Server running on port ' + PORT));"
    ],
    "description": "Express server skeleton"
  },
