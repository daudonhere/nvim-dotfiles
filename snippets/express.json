  "Express express-validator": {
    "prefix": "exvbody",
    "body": [
      "const { body, validationResult } = require('express-validator');",
      "",
      "app.post(",
      "  '${1:/route}',",
      "  [body('${2:name}').isLength({ min: ${3:3} })],",
      "  (req, res) => {",
      "    const errors = validationResult(req);",
      "    if (!errors.isEmpty()) {",
      "      return res.status(400).json({ errors: errors.array() });",
      "    }",
      "    ${4}",
      "  }",
      ");"
    ],
    "description": "Express express-validator"
  },
  "Express JWT sign": {
    "prefix": "exjwt",
    "body": [
      "const jwt = require('jsonwebtoken');",
      "",
      "const token = jwt.sign({ ${1:id} }, process.env.JWT_SECRET, { expiresIn: '${2:7d}' });"
    ],
    "description": "Express jwt.sign"
  },
  "Express JWT verify": {
    "prefix": "exjwtv",
    "body": [
      "const decoded = jwt.verify(${1:token}, process.env.JWT_SECRET);"
    ],
    "description": "Express jwt.verify"
  },
  "Express JWT middleware": {
    "prefix": "exauth",
    "body": [
      "const jwt = require('jsonwebtoken');",
      "",
      "const auth = (req, res, next) => {",
      "  const token = req.headers.authorization?.split(' ')[1];",
      "  if (!token) return res.status(401).json({ error: 'No token' });",
      "  try {",
      "    req.user = jwt.verify(token, process.env.JWT_SECRET);",
      "    next();",
      "  } catch {",
      "    res.status(401).json({ error: 'Invalid token' });",
      "  }",
      "};"
    ],
    "description": "Express JWT auth middleware"
  },
  "Express bcrypt": {
    "prefix": "exbcrypt",
    "body": [
      "const bcrypt = require('bcrypt');",
      "",
      "const hash = await bcrypt.hash(${1:password}, ${2:10});",
      "const match = await bcrypt.compare(${1:password}, hash);"
    ],
    "description": "Express bcrypt hash/compare"
  },
