      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "for...in loop (own properties)",
    "luasnip": { "autotrigger": true }
  },
  "foreach": {
    "prefix": "foreach",
    "body": [
      "${1:array}.forEach((${2:item}) => {",
      "\t$0",
      "})"
    ],
    "description": "Array.forEach",
    "luasnip": { "autotrigger": true }
  },
  "fori": {
    "prefix": "fori",
    "body": [
      "for (let ${1:i} = 0; ${1:i} < ${2:array}.length; ${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "index-based for loop"
  },
  "guard": {
    "prefix": "guard",
    "body": ["if (${1:!condition}) return;"],
    "description": "early return guard clause",
    "luasnip": { "autotrigger": true }
  },
  "tryc": {
    "prefix": "tryc",
    "body": [
