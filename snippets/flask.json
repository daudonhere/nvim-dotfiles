{
  "Flask app": {
    "prefix": "fls",
    "body": [
      "from flask import Flask, jsonify, request",
      "",
      "app = Flask(__name__)",
      "",
      "@app.route('/${1:yourRoute}')",
      "def ${2:yourIndex}():",
      "    return jsonify({'${3:yourMessage}': '${4:Hello World}'})",
      "",
      "if __name__ == '__main__':",
      "    app.run(debug=${5:yourTrue})"
    ],
    "description": "Flask app skeleton"
  },
  "Flask app factory": {
    "prefix": "flappfac",
    "body": [
      "from flask import Flask",
      "",
      "def create_app():",
      "    app = Flask(__name__)",
      "    app.config.from_object('${1:config.Config}')",
      "",
      "    from .${2:yourViews} import ${2:yourViews}_bp",
      "    app.register_blueprint(${2:yourViews}_bp)",
      "",
      "    return app"
    ],
    "description": "Flask app factory"
  },
  "Flask route GET": {
    "prefix": "flg",
    "body": [
      "@app.route('${1:/route}')",
      "def ${2:yourView}():",
      "    ${3}"
    ],
    "description": "Flask GET route"
  },
  "Flask route POST": {
    "prefix": "flp",
    "body": [
      "@app.route('${1:/route}', methods=['POST'])",
      "def ${2:yourView}():",
      "    data = request.json",
      "    ${3}"
    ],
    "description": "Flask POST route"
  },
  "Flask route GET+POST": {
    "prefix": "flgp",
    "body": [
      "@app.route('${1:/route}', methods=['GET', 'POST'])",
      "def ${2:yourView}():",
      "    ${3}"
    ],
    "description": "Flask GET+POST route"
  },
  "Flask route dynamic": {
    "prefix": "flgdyn",
    "body": [
      "@app.route('${1:/route}/<int:${2:yourId}>')",
      "def ${3:yourView}(${2:yourId}):",
      "    ${4}"
    ],
    "description": "Flask dynamic route"
  },
  "Flask blueprint": {
    "prefix": "flb",
    "body": [
      "from flask import Blueprint",
      "",
      "${1:yourBp} = Blueprint('${1:yourBp}', __name__)",
      "",
      "@${1:yourBp}.route('${2:/route}')",
      "def ${3:yourView}():",
      "    ${4}"
    ],
    "description": "Flask blueprint"
  },
  "Flask register blueprint": {
    "prefix": "flreg",
    "body": [
      "app.register_blueprint(${1:yourBp}, url_prefix='/${2:yourPrefix}')"
    ],
    "description": "Flask register_blueprint"
  },
  "Flask jsonify": {
    "prefix": "fljson",
    "body": [
      "return jsonify({${1:'message': 'ok'}}), ${2:200}"
    ],
    "description": "Flask jsonify response"
  },
  "Flask render template": {
    "prefix": "flrender",
    "body": [
      "return render_template('${1:yourIndex}.html', ${2:name=name})"
    ],
    "description": "Flask render_template"
  },
  "Flask redirect": {
    "prefix": "flredir",
    "body": [
      "return redirect(url_for('${1:yourView}'))"
    ],
    "description": "Flask redirect + url_for"
  },
  "Flask url_for": {
    "prefix": "flurl",
    "body": [
      "url_for('${1:yourView}')"
    ],
    "description": "Flask url_for"
  },
  "Flask static url": {
    "prefix": "flstatic",
    "body": [
      "url_for('static', filename='${1:css/style.css}')"
    ],
    "description": "Flask static url_for"
  },
  "Flask flash": {
    "prefix": "flflash",
    "body": [
      "flash('${1:yourMessage}', '${2:yourSuccess}')"
    ],
    "description": "Flask flash message"
  },
  "Flask abort": {
    "prefix": "flabort",
    "body": [
      "from flask import abort",
      "",
      "abort(${1:404}, description='${2:Not found}')"
    ],
    "description": "Flask abort"
  },
  "Flask get_or_404": {
    "prefix": "flget",
    "body": [
      "from flask import get_or_404",
      "",
      "${1:yourThing} = get_or_404(${2:yourThing}, id=${3:yourId})"
    ],
    "description": "Flask get_or_404"
  },
  "Flask error handler": {
    "prefix": "fl404",
    "body": [
      "@app.errorhandler(${1:404})",
      "def ${2:yourNot_found}(error):",
      "    return jsonify({'error': '${3:Not found}'}), ${1:404}"
    ],
    "description": "Flask errorhandler"
  },
  "Flask request args": {
    "prefix": "flargs",
    "body": [
      "${1:yourQuery} = request.args.get('${2:yourQ}', '')"
    ],
    "description": "Flask request.args.get"
  },
  "Flask request form": {
    "prefix": "flform",
    "body": [
      "${1:yourName} = request.form.get('${2:yourName}')"
    ],
    "description": "Flask request.form.get"
  },
  "Flask request json": {
    "prefix": "fljsonreq",
    "body": [
      "data = request.get_json() or {}",
      "${1:yourName} = data.get('${2:yourName}')"
    ],
    "description": "Flask request.get_json"
  },
  "Flask session": {
    "prefix": "flsession",
    "body": [
      "from flask import session",
      "",
      "session['${1:yourUser_id}'] = ${2:yourUser_id}"
    ],
    "description": "Flask session"
  },
  "Flask CORS": {
    "prefix": "flcors",
    "body": [
      "from flask_cors import CORS",
      "",
      "CORS(app, origins=['${1:http://localhost:5173}'])"
    ],
    "description": "Flask flask-cors"
  },
  "Flask SQLAlchemy": {
    "prefix": "flsql",
    "body": [
      "from flask_sqlalchemy import SQLAlchemy",
      "",
      "app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///${1:yourApp}.db'",
      "db = SQLAlchemy(app)"
    ],
    "description": "Flask SQLAlchemy setup"
  },
  "Flask model": {
    "prefix": "flmodel",
    "body": [
      "class ${1:yourUser}(db.Model):",
      "    id = db.Column(db.Integer, primary_key=True)",
      "    ${2:yourName} = db.Column(db.String(${3:80}), nullable=False)"
    ],
    "description": "Flask SQLAlchemy model"
  },
  "Flask relationship": {
    "prefix": "flrel",
    "body": [
      "${1:yourThings} = db.relationship('${2:yourThing}', backref='${3:yourOwner}', lazy=True)"
    ],
    "description": "Flask SQLAlchemy relationship"
  },
  "Flask query": {
    "prefix": "flquery",
    "body": [
      "results = ${1:yourThing}.query.filter_by(${2:yourField}=${3:yourValue}).all()",
      "print(results)"
    ],
    "description": "Flask query filter_by"
  },
  "Flask first_or_404": {
    "prefix": "flfirst",
    "body": [
      "${1:yourThing}.query.get_or_404(${2:yourId})"
    ],
    "description": "Flask query get_or_404"
  },
  "Flask migrate": {
    "prefix": "flmig",
    "body": [
      "from flask_migrate import Migrate",
      "",
      "migrate = Migrate(app, db)"
    ],
    "description": "Flask flask-migrate"
  },
  "Flask config": {
    "prefix": "flconfig",
    "body": [
      "import os",
      "",
      "class Config:",
      "    SECRET_KEY = os.environ.get('SECRET_KEY') or '${1:dev-key}'",
      "    ${2:yourSQLALCHEMY_DATABASE_URI} = os.environ.get('${2:yourDATABASE_URL}')"
    ],
    "description": "Flask config class"
  },
  "Flask before_request": {
    "prefix": "flbefore",
    "body": [
      "@app.before_request",
      "def ${1:yourBefore}():",
      "    ${2}"
    ],
    "description": "Flask before_request hook"
  },
  "Flask teardown": {
    "prefix": "flteardown",
    "body": [
      "@app.teardown_appcontext",
      "def ${1:yourCleanup}(exception):",
      "    ${2}"
    ],
    "description": "Flask teardown_appcontext"
  },
  "Flask make_response": {
    "prefix": "flresp",
    "body": [
      "from flask import make_response",
      "",
      "response = make_response(${1:jsonify({})}, ${2:200})",
      "response.headers['${3:X-Custom}'] = '${4:yourValue}'"
    ],
    "description": "Flask make_response"
  },
  "Flask app context": {
    "prefix": "flappctx",
    "body": [
      "with app.app_context():",
      "    ${1}"
    ],
    "description": "Flask app_context"
  },
  "Flask CLI command": {
    "prefix": "flcli",
    "body": [
      "import click",
      "from flask.cli import with_appcontext",
      "",
      "@app.cli.command('${1:yourCmd}')",
      "@with_appcontext",
      "def ${1:yourCmd}_command():",
      "    ${2}"
    ],
    "description": "Flask Click CLI command"
  },
  "Flask app.run": {
    "prefix": "flrun",
    "body": [
      "if __name__ == '__main__':",
      "    app.run(host='${1:0.0.0.0}', port=${2:5000}, debug=${3:yourTrue})"
    ],
    "description": "Flask app.run"
  },
  "Flask template for": {
    "prefix": "fltplfor",
    "body": [
      "{% for ${1:yourItem} in ${2:yourItems} %}",
      "  ${3}",
      "{% endfor %}"
    ],
    "description": "Flask Jinja for loop"
  },
  "Flask template if": {
    "prefix": "fltplif",
    "body": [
      "{% if ${1:yourCondition} %}",
      "  ${2}",
      "{% endif %}"
    ],
    "description": "Flask Jinja if"
  },
  "Flask template extends": {
    "prefix": "fltplext",
    "body": [
      "{% extends '${1:yourBase}.html' %}",
      "",
      "{% block ${2:yourContent} %}",
      "{% endblock %}"
    ],
    "description": "Flask Jinja extends"
  },
  "Flask request object": {
    "prefix": "flrequestobj",
    "body": [
      "from flask import request",
      "",
      "print(request.method, request.path, request.args, request.json)"
    ],
    "description": "Flask request object debug"
  },
  "Flask upload file": {
    "prefix": "flfiles",
    "body": [
      "file = request.files['${1:yourFile}']",
      "file.save('${2:uploads/}' + file.filename)"
    ],
    "description": "Flask request.files save"
  },
  "Flask json body": {
    "prefix": "fljsonbody",
    "body": [
      "data = request.get_json(silent=True) or {}"
    ],
    "description": "Flask request.get_json"
  },
  "Flask session get": {
    "prefix": "flsessionget",
    "body": [
      "user_id = session.get('${1:yourUser_id}')"
    ],
    "description": "Flask session.get"
  },
  "Flask session pop": {
    "prefix": "flsessionpop",
    "body": [
      "session.pop('${1:yourUser_id}', None)"
    ],
    "description": "Flask session.pop"
  },
  "Flask send_file": {
    "prefix": "flsendfile",
    "body": [
      "from flask import send_file",
      "",
      "return send_file('${1:files/report.pdf}', as_attachment=True)"
    ],
    "description": "Flask send_file"
  },
  "Flask streaming response": {
    "prefix": "flstream",
    "body": [
      "from flask import Response, stream_with_context",
      "",
      "@app.route('${1:/stream}')",
      "def stream():",
      "    @stream_with_context",
      "    def gen():",
      "        yield '${2:yourChunk}'",
      "    return Response(gen())"
    ],
    "description": "Flask streaming response"
  },
  "Flask MethodView": {
    "prefix": "flmethodview",
    "body": [
      "from flask.views import MethodView",
      "",
      "class ${1:yourThing}API(MethodView):",
      "    def get(self):",
      "        ${2}",
      "        return jsonify(${3:{}})"
    ],
    "description": "Flask MethodView"
  },
  "Flask context_processor": {
    "prefix": "flcontextproc",
    "body": [
      "@app.context_processor",
      "def inject_globals():",
      "    return {'${1:yourApp_name}': '${2:yourMyApp}'}"
    ],
    "description": "Flask context_processor"
  },
  "Flask WTForms": {
    "prefix": "flwtf",
    "body": [
      "from flask_wtf import FlaskForm",
      "from wtforms import StringField, SubmitField",
      "from wtforms.validators import DataRequired",
      "",
      "class ${1:yourThing}Form(FlaskForm):",
      "    ${2:yourName} = StringField('${2:yourName}', validators=[DataRequired()])",
      "    submit = SubmitField('Save')"
    ],
    "description": "Flask WTForms form"
  },
  "Flask validate_on_submit": {
    "prefix": "flwtfvalidate",
    "body": [
      "if ${1:yourForm}.validate_on_submit():",
      "    ${2}"
    ],
    "description": "Flask WTForms validate"
  },
  "Flask query filter": {
    "prefix": "flqueryfilter",
    "body": [
      "results = ${1:yourThing}.query.filter(${1:yourThing}.${2:yourField} == ${3:yourValue}).all()",
      "print(results)"
    ],
    "description": "Flask query filter"
  },
  "Flask query order": {
    "prefix": "flqueryorder",
    "body": [
      "results = ${1:yourThing}.query.order_by(${1:yourThing}.${2:yourCreated_at}.desc()).all()",
      "print(results)"
    ],
    "description": "Flask query order_by"
  },
  "Flask query first": {
    "prefix": "flqueryfirst",
    "body": [
      "${1:yourThing} = ${2:yourThing}.query.filter_by(${3:yourField}=${4:yourValue}).first()",
      "print(${1:yourThing})"
    ],
    "description": "Flask query first"
  },
  "Flask paginate": {
    "prefix": "flquerypaginate",
    "body": [
      "${1:yourPage} = ${2:yourThing}.query.paginate(page=${3:yourPage}, per_page=${4:10}, error_out=False)",
      "print(${1:yourPage}.items)"
    ],
    "description": "Flask paginate"
  },
  "Flask count": {
    "prefix": "flquerycount",
    "body": [
      "count = ${1:yourThing}.query.count()",
      "print(count)"
    ],
    "description": "Flask query count"
  },
  "Flask config classes": {
    "prefix": "flconfigdev",
    "body": [
      "class ${1:yourDevelopment}Config(Config):",
      "    DEBUG = True",
      "",
      "class ${2:yourProduction}Config(Config):",
      "    DEBUG = False"
    ],
    "description": "Flask dev/prod config"
  },
  "Flask app.logger": {
    "prefix": "fllogger",
    "body": [
      "app.logger.info('${1:yourMessage}')",
      "app.logger.error('${2:yourError}')"
    ],
    "description": "Flask app.logger"
  },
  "Flask test client": {
    "prefix": "fltest",
    "body": [
      "import pytest",
      "",
      "def test_index(client):",
      "    res = client.get('${1:/}')",
      "    assert res.status_code == ${2:200}"
    ],
    "description": "Flask pytest test client"
  },
  "Flask health": {
    "prefix": "flhealth",
    "body": [
      "@app.route('/health')",
      "def health():",
      "    return jsonify({'status': 'ok'})"
    ],
    "description": "Flask health check"
  },
  "Flask macro": {
    "prefix": "fltplmacro",
    "body": [
      "{% macro ${1:yourInput}(name) %}",
      "<input type=\"text\" name=\"{{ name }}\">",
      "{% endmacro %}"
    ],
    "description": "Flask Jinja macro"
  },
  "Flask template include": {
    "prefix": "fltplinclude",
    "body": [
      "{% include '${1:yourPartial}.html' %}"
    ],
    "description": "Flask Jinja include"
  },
  "Flask template url": {
    "prefix": "fltplurl",
    "body": [
      "href=\"{{ url_for('${1:yourView}') }}\""
    ],
    "description": "Flask Jinja url_for"
  },
  "Flask template set": {
    "prefix": "fltplset",
    "body": [
      "{% set ${1:yourTotal} = ${2:yourA} + ${3:yourB} %}"
    ],
    "description": "Flask Jinja set"
  }
}