  "FastAPI JWT create": {
    "prefix": "fajwt",
    "body": [
      "import jwt",
      "from datetime import datetime, timedelta",
      "",
      "def create_token(subject: str) -> str:",
      "    payload = {",
      "        'sub': subject,",
      "        'exp': datetime.utcnow() + timedelta(hours=${1:24}),",
      "    }",
      "    return jwt.encode(payload, ${2:settings.SECRET_KEY}, algorithm='HS256')"
    ],
    "description": "FastAPI JWT token creator"
  },
  "FastAPI HTTPException": {
    "prefix": "fahttp",
