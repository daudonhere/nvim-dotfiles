    "prefix": "faengine",
    "body": [
      "from sqlalchemy import create_engine",
      "from sqlalchemy.orm import sessionmaker",
      "",
      "engine = create_engine('${1:sqlite:///app.db}')",
      "SessionLocal = sessionmaker(bind=engine)"
    ],
    "description": "FastAPI SQLAlchemy engine/session"
  },
  "FastAPI SQLAlchemy model": {
    "prefix": "fasqlmodel",
    "body": [
      "from sqlalchemy import Column, Integer, String",
      "from sqlalchemy.orm import DeclarativeBase",
      "",
      "class Base(DeclarativeBase):",
      "    pass",
      "",
      "class ${1:Thing}(Base):",
      "    __tablename__ = '${2:things}'",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    ${3:name} = Column(String(${4:255}), nullable=False)"
    ],
    "description": "FastAPI SQLAlchemy 2.0 model"
  },
