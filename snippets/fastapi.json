  "FastAPI get_current_user": {
    "prefix": "facurrent",
    "body": [
      "def get_current_user(token: str = Depends(oauth2_scheme)) -> ${1:User}:",
      "    ${2}",
      "    return user",
      "",
      "# usage",
      "user: ${1:User} = Depends(get_current_user)"
    ],
    "description": "FastAPI current user dependency"
  },
  "FastAPI JWT verify": {
    "prefix": "fajwtverify",
    "body": [
      "def verify_token(token: str = Depends(oauth2_scheme)) -> dict:",
      "    try:",
      "        payload = jwt.decode(token, ${1:settings.SECRET_KEY}, algorithms=['HS256'])",
      "        return payload",
      "    except jwt.ExpiredSignatureError:",
      "        raise HTTPException(status_code=401, detail='token expired')"
    ],
    "description": "FastAPI JWT verify dependency"
  },
  "FastAPI passlib": {
    "prefix": "fahash",
    "body": [
      "from passlib.context import CryptContext",
      "",
      "pwd_context = CryptContext(schemes=['bcrypt'], deprecated='auto')",
      "",
      "def hash_password(password: str) -> str:",
      "    return pwd_context.hash(password)",
      "",
      "def verify_password(plain: str, hashed: str) -> bool:",
      "    return pwd_context.verify(plain, hashed)"
    ],
    "description": "FastAPI passlib hash/verify"
  },
