{
  "FastAPI app": {
    "prefix": "fapi",
    "body": [
      "from fastapi import FastAPI",
      "",
      "app = FastAPI()",
      "",
      "@app.get('/')",
      "def root():",
      "    return {'${1:message}': '${2:Hello World}'}"
    ],
    "description": "FastAPI app skeleton"
  },
  "FastAPI router": {
    "prefix": "far",
    "body": [
      "from fastapi import APIRouter",
      "",
      "router = APIRouter(prefix='/${1:route}', tags=['${1:route}'])",
      "",
      "@router.get('/${2}')",
      "def ${3:read_item}():",
      "    ${4}"
    ],
    "description": "FastAPI router module"
  },
  "FastAPI GET": {
    "prefix": "fag",
    "body": [
      "@${1:router}.get('${2:/path}')",
      "def ${3:read_item}():",
      "    ${4}"
    ],
    "description": "FastAPI GET endpoint"
  },
  "FastAPI GET async": {
    "prefix": "fagasync",
    "body": [
      "@${1:router}.get('${2:/path}')",
      "async def ${3:read_item}():",
      "    ${4}"
    ],
    "description": "FastAPI async GET endpoint"
  },
  "FastAPI POST": {
    "prefix": "fap",
    "body": [
      "@${1:router}.post('${2:/path}', status_code=${3:201})",
      "def ${4:create_item}(payload: ${5:Item}):",
      "    ${6}"
    ],
    "description": "FastAPI POST endpoint"
  },
  "FastAPI POST async": {
    "prefix": "fapasync",
    "body": [
      "@${1:router}.post('${2:/path}', status_code=${3:201})",
      "async def ${4:create_item}(payload: ${5:Item}):",
      "    ${6}"
    ],
    "description": "FastAPI async POST endpoint"
  },
  "FastAPI PUT": {
    "prefix": "faput",
    "body": [
      "@${1:router}.put('${2:/path}/{item_id}')",
      "def ${3:update_item}(item_id: int, payload: ${4:Item}):",
      "    ${5}"
    ],
    "description": "FastAPI PUT endpoint"
  },
  "FastAPI PATCH": {
    "prefix": "fapatch",
    "body": [
      "@${1:router}.patch('${2:/path}/{item_id}')",
      "def ${3:update_item}(item_id: int, payload: ${4:Item}):",
      "    ${5}"
    ],
    "description": "FastAPI PATCH endpoint"
  },
  "FastAPI DELETE": {
    "prefix": "fadel",
    "body": [
      "@${1:router}.delete('${2:/path}/{item_id}', status_code=${3:204})",
      "def ${4:delete_item}(item_id: int):",
      "    ${5}"
    ],
    "description": "FastAPI DELETE endpoint"
  },
  "FastAPI DTO": {
    "prefix": "fabm",
    "body": [
      "from pydantic import BaseModel",
      "",
      "class ${1:Item}(BaseModel):",
      "    ${2:name}: str",
      "    ${3:price}: float"
    ],
    "description": "FastAPI Pydantic model"
  },
  "FastAPI DTO response": {
    "prefix": "fabmres",
    "body": [
      "from pydantic import BaseModel, ConfigDict",
      "",
      "class ${1:Item}(BaseModel):",
      "    model_config = ConfigDict(from_attributes=True)",
      "",
      "    id: int",
      "    ${2:name}: str"
    ],
    "description": "FastAPI Pydantic response model"
  },
  "FastAPI response_model": {
    "prefix": "faresp",
    "body": [
      "response_model=${1:Item}"
    ],
    "description": "FastAPI response_model param"
  },
  "FastAPI Field": {
    "prefix": "fafield",
    "body": [
      "from pydantic import Field",
      "",
      "${1:name}: str = Field(..., min_length=${2:1}, max_length=${3:255})"
    ],
    "description": "FastAPI pydantic Field"
  },
  "FastAPI field_validator": {
    "prefix": "favalidator",
    "body": [
      "from pydantic import field_validator",
      "",
      "@field_validator('${1:name}')",
      "@classmethod",
      "def validate_${1:name}(cls, v):",
      "    if not v:",
      "        raise ValueError('${2:cannot be empty}')",
      "    return v"
    ],
    "description": "FastAPI pydantic field_validator"
  },
  "FastAPI include_router": {
    "prefix": "fainclude",
    "body": [
      "app.include_router(${1:router}, prefix='/${2:api}', tags=['${2:api}'])"
    ],
    "description": "FastAPI app.include_router"
  },
  "FastAPI CORS": {
    "prefix": "facors",
    "body": [
      "from fastapi.middleware.cors import CORSMiddleware",
      "",
      "app.add_middleware(",
      "    CORSMiddleware,",
      "    allow_origins=['${1:http://localhost:5173}'],",
      "    allow_credentials=True,",
      "    allow_methods=['*'],",
      "    allow_headers=['*'],",
      ")"
    ],
    "description": "FastAPI CORS middleware"
  },
  "FastAPI http middleware": {
    "prefix": "famid",
    "body": [
      "@app.middleware('http')",
      "async def ${1:log_requests}(request: Request, call_next):",
      "    response = await call_next(request)",
      "    return response"
    ],
    "description": "FastAPI @app.middleware"
  },
  "FastAPI lifespan": {
    "prefix": "falife",
    "body": [
      "from contextlib import asynccontextmanager",
      "",
      "@asynccontextmanager",
      "async def lifespan(app: FastAPI):",
      "    ${1:await init()}",
      "    yield",
      "    ${2:await cleanup()}",
      "",
      "app = FastAPI(lifespan=lifespan)"
    ],
    "description": "FastAPI lifespan context"
  },
  "FastAPI dependency function": {
    "prefix": "fadep",
    "body": [
      "def ${1:get_dep}(request: Request):",
      "    ${2}"
    ],
    "description": "FastAPI dependency function"
  },
  "FastAPI Depends": {
    "prefix": "fadepends",
    "body": [
      "from fastapi import Depends",
      "",
      "${1:dep}: ${2:Type} = Depends(${3:get_dep})"
    ],
    "description": "FastAPI Depends usage"
  },
  "FastAPI settings": {
    "prefix": "fasetting",
    "body": [
      "from pydantic_settings import BaseSettings",
      "",
      "class Settings(BaseSettings):",
      "    ${1:api_key}: str = ''",
      "",
      "    class Config:",
      "        env_file = '.env'",
      "",
      "settings = Settings()"
    ],
    "description": "FastAPI pydantic settings"
  },
  "FastAPI get_db": {
    "prefix": "fagetdb",
    "body": [
      "def get_db():",
      "    db = ${1:SessionLocal}()",
      "    try:",
      "        yield db",
      "    finally:",
      "        db.close()"
    ],
    "description": "FastAPI SQLAlchemy session dependency"
  },
