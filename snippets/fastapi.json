      "def ${1:send_email}(email: str):",
      "    ${2}",
      "",
      "def endpoint(background_tasks: BackgroundTasks):",
      "    background_tasks.add_task(${1:send_email}, '${3:user@example.com}')",
      "    return {'status': 'queued'}"
    ],
    "description": "FastAPI BackgroundTasks"
